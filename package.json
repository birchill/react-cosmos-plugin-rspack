{
  "name": "react-cosmos-plugin-rspack",
  "version": "2.0.0",
  "description": "rspack plugin for React Cosmos",
  "repository": "https://github.com/birchill/react-cosmos-plugin-rspack/",
  "author": "Birchill, Inc.",
  "license": "MIT",
  "main": "./cosmos.plugin.json",
  "files": [
    "dist/**",
    "cosmos.plugin.json"
  ],
  "type": "module",
  "dependencies": {
    "react-cosmos-dom": "^7.1.0",
    "webpack-dev-middleware": "7.4.5",
    "webpack-hot-middleware": "2.26.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "10.0.1",
    "@rollup/plugin-virtual": "3.0.2",
    "@rspack/core": "1.5.8",
    "@types/node": "22.15.30",
    "@types/webpack-hot-middleware": "2.25.11",
    "husky": "9.1.7",
    "knip": "5.64.2",
    "lint-staged": "16.2.3",
    "prettier": "3.6.2",
    "react-cosmos": "7.2.0",
    "react-cosmos-core": "7.2.0",
    "react-error-overlay": "6.0.9",
    "react-plugin": "3.0.0-alpha.4",
    "release-it": "19.0.5",
    "tsdown": "0.15.6",
    "typescript": "5.9.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown && cp src/server/rspackConfig/userImportsLoader.cjs dist/server",
    "release": "release-it",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@rspack/core": ">=1.0.0",
    "react-cosmos": "^7.1.0"
  },
  "lint-staged": {
    "*.{ts,json,md}": [
      "prettier --write"
    ]
  }
}
